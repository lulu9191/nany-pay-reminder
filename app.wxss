/* 奶油底色与珊瑚橙：所有页面共用的视觉基础。 */
page {
  --color-primary: #c36549;
  --color-primary-deep: #a94f37;
  --color-primary-soft: #f5e5dd;
  --color-text: #302c28;
  --color-text-secondary: #756d65;
  --color-text-tertiary: #81776e;
  --color-bg: #f8f6f2;
  --color-card: #ffffff;
  --color-border: #eae4dc;
  --color-success: #38735b;
  --radius-lg: 28rpx;
  --radius-md: 20rpx;
  --shadow-card: 0 4rpx 16rpx rgba(48, 44, 40, 0.025);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background-color: var(--color-bg);
  line-height: 1.5;
  box-sizing: border-box;
}

view, text, image, button, input { box-sizing: border-box; }
button::after { border: none; }
button {
  padding: 0;
  margin: 0;
  line-height: inherit;
  background: transparent;
  font-family: inherit;
}
button[disabled] { opacity: 0.5; }
