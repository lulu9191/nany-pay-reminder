.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 36rpx 32rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #F8F6F2;
  color: #302C28;
}

.page-heading {
  margin-bottom: 38rpx;
}

.page-title {
  font-size: 44rpx;
  line-height: 1.35;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.page-sub {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: #756D65;
}

.section-heading {
  margin: 0 2rpx 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
  font-weight: 600;
}

.section-heading-gap {
  margin-top: 34rpx;
}

.form-card {
  padding: 0 28rpx;
  border: 1rpx solid #EAE4DC;
  border-radius: 28rpx;
  background: #FFFFFF;
  overflow: hidden;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}

.form-row-line {
  border-top: 1rpx solid #EAE4DC;
}

.form-row-block {
  display: block;
}

.form-text {
  flex: 1;
  min-width: 0;
}

.form-label {
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 500;
  color: #302C28;
}

.form-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #756D65;
}

.picker-end,
.toggle-end {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 18rpx;
}

.picker-value {
  font-size: 26rpx;
  line-height: 1.5;
  color: #302C28;
  font-variant-numeric: tabular-nums;
}

.picker-placeholder {
  color: #756D65;
}

.chevron {
  width: 12rpx;
  height: 12rpx;
  margin-left: 18rpx;
  margin-right: 4rpx;
  border-top: 2rpx solid #A69B90;
  border-right: 2rpx solid #A69B90;
  transform: rotate(45deg);
  flex-shrink: 0;
}

.week-chips {
  display: flex;
  gap: 10rpx;
  margin-top: 20rpx;
}

.week-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0;
  margin: 0;
  border: 1rpx solid transparent;
  border-radius: 16rpx;
  background: #F8F6F2;
  color: #756D65;
  font-size: 24rpx;
  line-height: 1;
  white-space: nowrap;
}

.week-chip-active {
  border-color: #E5BEAD;
  background: #F5E5DD;
  color: #A34F36;
  font-weight: 600;
}

.holiday-row .form-text {
  padding-right: 18rpx;
}

.holiday-switch {
  flex-shrink: 0;
  transform: scale(0.88);
  transform-origin: right center;
}

.section-note {
  margin: 14rpx 4rpx 0;
  font-size: 22rpx;
  line-height: 1.7;
  color: #756D65;
}

.advanced-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 28rpx 0;
  text-align: left;
  border-radius: 0;
}

.toggle-end {
  color: #756D65;
  font-size: 23rpx;
}

.chevron-down {
  transform: rotate(135deg);
  margin-top: -6rpx;
}

.chevron-open {
  transform: rotate(-45deg);
  margin-top: 6rpx;
}

.anchor-summary-active {
  color: #A34F36;
}

.advanced-content {
  padding: 24rpx 0 28rpx;
  border-top: 1rpx solid #EAE4DC;
}

.advanced-description {
  font-size: 24rpx;
  line-height: 1.7;
  color: #756D65;
}

.anchor-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
}

.anchor-picker {
  flex: 1;
  min-width: 0;
}

.anchor-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #EAE4DC;
  border-radius: 20rpx;
  font-size: 25rpx;
}

.anchor-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #F8F6F2;
  color: #756D65;
  font-size: 25rpx;
}

.anchor-note {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #756D65;
}

.cta-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  margin-top: 28rpx;
  border-radius: 20rpx;
  background: #A94F37;
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 500;
}

.save-note {
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.6;
  color: #756D65;
}

.backup-heading {
  margin-top: 40rpx;
}

.backup-card {
  padding: 28rpx;
}

.backup-description {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #756D65;
}

.backup-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.backup-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 80rpx;
  border: 1rpx solid #EAE4DC;
  border-radius: 20rpx;
  color: #756D65;
  font-size: 26rpx;
  font-weight: 500;
}

.backup-btn-main {
  border-color: transparent;
  background: #F5E5DD;
  color: #A34F36;
}

.backup-note {
  margin-top: 18rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #756D65;
}

.privacy-note {
  margin-top: 26rpx;
  text-align: center;
  color: #756D65;
  font-size: 22rpx;
  line-height: 1.6;
}

.button-pressed {
  opacity: 0.75;
}
