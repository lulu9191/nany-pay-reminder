.detail-page {
  min-height: 100vh;
  padding: 36rpx 32rpx 64rpx;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  background: #F8F6F2;
  color: #302C28;
}

.page-heading { margin: 4rpx 4rpx 32rpx; }
.page-eyebrow { color: #756D65; font-size: 22rpx; letter-spacing: 2rpx; }
.page-title { margin-top: 12rpx; font-size: 46rpx; font-weight: 600; line-height: 1.3; }
.page-description { margin-top: 12rpx; color: #756D65; font-size: 26rpx; line-height: 1.6; }

.summary-card, .calendar-card, .daily-card, .empty-card {
  padding: 30rpx;
  background: #FFFFFF;
  border: 1rpx solid #EAE4DC;
  border-radius: 28rpx;
}

.calendar-card, .daily-card { margin-top: 24rpx; }
.card-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.section-title { font-size: 29rpx; font-weight: 600; }
.section-caption { color: #756D65; font-size: 22rpx; }
.cycle-badge { padding: 8rpx 16rpx; border-radius: 10rpx; background: #F5E5DD; color: #C36549; font-size: 22rpx; white-space: nowrap; }

.date-range { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin: 34rpx 0 30rpx; }
.range-end { display: flex; flex-direction: column; gap: 12rpx; }
.range-end-right { text-align: right; }
.range-label { color: #756D65; font-size: 22rpx; }
.range-date { font-size: 29rpx; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
.range-date-payday { color: #C36549; }
.range-connector { width: 28rpx; height: 2rpx; margin-top: 34rpx; flex-shrink: 0; background: #EAE4DC; }
.summary-counts { display: flex; border-top: 1rpx solid #EAE4DC; padding-top: 26rpx; }
.summary-count { width: 50%; }
.summary-count + .summary-count { border-left: 1rpx solid #EAE4DC; padding-left: 34rpx; }
.count-value { font-size: 52rpx; font-weight: 600; line-height: 1.2; color: #C36549; font-variant-numeric: tabular-nums; }
.count-value-muted { color: #302C28; }
.count-unit { margin-left: 8rpx; color: #756D65; font-size: 22rpx; }
.count-label { display: block; margin-top: 10rpx; color: #756D65; font-size: 24rpx; }
.summary-note { margin-top: 26rpx; color: #756D65; font-size: 22rpx; line-height: 1.6; }

.month-navigation { display: flex; align-items: center; justify-content: space-between; margin: 28rpx 0 22rpx; }
.month-title { font-size: 27rpx; font-weight: 600; font-variant-numeric: tabular-nums; }
.month-button { display: flex; align-items: center; justify-content: center; min-width: 82rpx; height: 60rpx; padding: 0 16rpx; border-radius: 14rpx; background: #F8F6F2; color: #756D65; font-size: 23rpx; }
.month-button[disabled] { background: #F8F6F2; color: #BBB3AB; }
.month-button::after { border: 0; }
.week-heading, .month-grid { display: flex; flex-wrap: wrap; }
.week-label { width: 14.285714%; padding-bottom: 14rpx; text-align: center; color: #756D65; font-size: 22rpx; }
.calendar-cell { width: 14.285714%; height: 90rpx; padding: 3rpx; }
.calendar-cell-inner { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 84rpx; gap: 4rpx; border: 1rpx solid transparent; border-radius: 14rpx; }
.calendar-number { font-size: 26rpx; line-height: 1.1; font-weight: 500; font-variant-numeric: tabular-nums; }
.calendar-day-label { min-height: 22rpx; font-size: 18rpx; line-height: 1.2; }
.calendar-cell-work .calendar-cell-inner { background: #F5E5DD; color: #A45139; }
.calendar-cell-rest .calendar-cell-inner { border-color: #EAE4DC; color: #756D65; }
.calendar-cell-payday .calendar-cell-inner { background: #C36549; color: #FFFFFF; }
.calendar-cell-payday .calendar-number { font-weight: 700; }
.calendar-cell-outside .calendar-cell-inner { color: #BDB5AC; }
.calendar-cell-empty { pointer-events: none; }
.calendar-legend { display: flex; flex-wrap: wrap; align-items: center; gap: 18rpx; margin-top: 22rpx; color: #756D65; font-size: 20rpx; line-height: 1.5; }
.legend-item { display: flex; align-items: center; gap: 7rpx; }
.legend-mark { width: 16rpx; height: 16rpx; border-radius: 4rpx; }
.legend-work { background: #F5E5DD; }
.legend-rest { border: 1rpx solid #CFC5BA; background: #FFFFFF; }
.legend-payday { background: #C36549; }
.legend-outside { margin-left: auto; font-size: 19rpx; }

.daily-heading { padding-bottom: 12rpx; }
.day-row { display: flex; align-items: center; gap: 18rpx; min-height: 96rpx; padding: 18rpx 0; border-bottom: 1rpx solid #EAE4DC; }
.day-row:last-child { border-bottom: 0; }
.day-date-group { width: 118rpx; flex-shrink: 0; display: flex; flex-direction: column; gap: 7rpx; }
.day-date { font-size: 25rpx; font-weight: 500; white-space: nowrap; }
.day-weekday { font-size: 21rpx; color: #756D65; }
.day-reason-group { display: flex; flex-direction: column; gap: 6rpx; flex: 1; min-width: 0; }
.day-reason { color: #756D65; font-size: 23rpx; line-height: 1.5; }
.day-payday-caption { color: #C36549; font-size: 21rpx; font-weight: 600; }
.day-count { flex-shrink: 0; padding: 8rpx 12rpx; border-radius: 9rpx; font-size: 21rpx; white-space: nowrap; }
.day-count-work { background: #F5E5DD; color: #A45139; }
.day-count-rest { background: #F8F6F2; color: #756D65; }
.day-row-payday .day-date { color: #C36549; }
.day-row-payday .day-count { background: #C36549; color: #FFFFFF; }

.notice { margin-bottom: 22rpx; padding: 22rpx 26rpx; border-radius: 18rpx; background: #F5E5DD; color: #8B4C36; font-size: 24rpx; line-height: 1.6; }
.notice-loading { background: #EEEAE3; color: #756D65; }
.explanation { margin: 30rpx 4rpx 0; color: #756D65; font-size: 23rpx; line-height: 1.8; }
.explanation-title { margin-bottom: 10rpx; color: #302C28; font-size: 25rpx; font-weight: 500; }
.explanation-settings { margin-top: 10rpx; }
.text-link { color: #C36549; text-decoration: underline; }
.empty-card { margin-top: 36rpx; padding: 44rpx 32rpx; }
.empty-title { font-size: 33rpx; font-weight: 600; }
.empty-description { margin-top: 18rpx; color: #756D65; font-size: 26rpx; line-height: 1.7; }
.primary-button { display: flex; align-items: center; justify-content: center; height: 88rpx; margin-top: 32rpx; border-radius: 18rpx; background: #C36549; color: #FFFFFF; font-size: 28rpx; font-weight: 500; }
.primary-button::after { border: 0; }
